general {
  output_format = "i3bar"
  colors = true
  markup = pango
  interval = 1
  color_good = "#50fa7b"
  color_bad = "#ff5555" 
  color_degraded = "#f1fa8c"
}

order += "tztime local"
order += "volume master"
order += "battery all"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "wireless _first_"
order += "ethernet _first_"
order += "ethernet nordlynx"

wireless _first_ {
  format_up = " %essid %quality"
  format_down = ""
  format_quality = "%03d%s"
}

ethernet _first_ {
  format_up = " %ip (%speed)"
  format_down = " Down"
}

ethernet nordlynx {
  format_up = " %ip"
  format_down = " Down"
}

battery all {
  format = "󱈏 %percentage %remaining"
  format_down = ""
  status_chr = "󰂄"
  status_bat = "[BAT]"
  status_full = "[FULL]"
  path = "/sys/class/power_supply/BAT%d/uevent"
  low_threshold = 15
  threshold_type = percentage
  hide_seconds = true
}

cpu_usage {
  format = "<span color='#666666'>󰍛 %usage</span>"
  max_threshold = 75
  degraded_threshold = 50
}

memory {
  format = "<span color='#666666'> %used</span>"
  threshold_degraded = "30%"
  threshold_critical = "5%"
  format_degraded = " %used"
}

disk "/" {
  format = "<span color='#666666'> %percentage_used</span>"
  prefix_type = custom
  low_threshold = 20
  threshold_type = percentage_avail
}

volume master {
  format = "<span color='#999999'> %volume</span>"
  format_muted = " Muted"
  device = "default"
  mixer = "Master"
  mixer_idx = 0
}

tztime local {
  format = " %a %m/%d  %H:%M:%S"
}
